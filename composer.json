{
    "name": "tyhpdef/php-di-php-di-impl",
    "description": "Implementation package for tyhpdef/php-di-php-di. Require tyhpdef/php-di-php-di, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "7.1.1.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/psr-container": "@dev",
                "tyhpdef/php-di-invoker": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/php-di-php-di"
        }
    },
    "require": {
        "php": ">=8.2",
        "php-di/php-di": "7.1.1"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/psr-container": "@dev",
        "tyhpdef/php-di-invoker": "@dev"
    }
}
